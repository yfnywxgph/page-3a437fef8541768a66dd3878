:0;right:0;height:10px;background:radial-gradient(circle at 5px 5px,#f4ecd8 4px,transparent 5px);background-size:14px 10px}\n.receipt::before{top:-10px}\n.receipt::after{bottom:-10px;transform:rotate(180deg)}\n.receipt h3{margin-bottom:10px}\n.receipt ol{margin-left:24px;font-size:14px}\n.receipt ol li{margin-bottom:8px}\n.receipt .stamps{margin-top:14px;display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:#7a4a3a}\n.receipt .stamps span{border:1px dashed #a93226;padding:3px 8px;letter-spacing:.15em}\n\n/* 客户端 */\n.clients{margin-top:18px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}\n.client{border:2px dashed #a93226;background:#fbf5e6;padding:16px}\n.client h4{font-size:15px;color:#2a1810;margin-bottom:6px}\n.client p{font-size:13px;color:#3a2418;margin-bottom:0}\n.client .src{font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;color:#7a4a3a;margin-top:8px}\n\n/* FAQ 编号列表 */\n.faq{margin-top:18px;counter-reset:q}\n.faq-q{border:2px dashed #a93226;background:#fbf5e6;padding:18px 22px;margin-bottom:14px;counter-increment:q;position:relative}\n.faq-q h3{font-size:16px;margin-bottom:8px;padding-left:38px}\n.faq-q h3::before{content:\"Q\" counter(q);position:absolute;left:22px;top:18px;font-size:13px;letter-spacing:.2em;color:#a93226;font-weight:700}\n.faq-q p{font-size:14px;color:#3a2418;margin-bottom:0;padding-left:38px}\n\n/* 底栏 */\nfooter{padding:30px 22px;text-align:center;font-size:12.5px;color:#7a4a3a;letter-spacing:.08em;border-top:2px dashed rgba(58,36,24,.25)}\nfooter p{margin-bottom:6px}\nfooter .minilinks a{margin:0 8px}\n\n@media(max-width:759px){\n  .topband{flex-direction:column;gap:8px;padding:14px 18px}\n  .topband .jump a{margin-left:0;margin-right:14px}\n  .hero{padding:32px 18px 24px}\n  section{padding:38px 18px}\n  .dash .num{font-size:28px}\n  .plan-row{padding:18px}\n}\n</style><div class=\"topband\">\n  <span class=\"mark\">StartSocks · 节点流量一览</span>\n  <span class=\"jump\">\n    <a href=\"#dashboard\">数据面板</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#use\">使用方法</a>\n    <a href=\"#faq\">常见问题</a>\n  </span>\n</div>\n\n<header class=\"hero\" id=\"dashboard\">\n  <div class=\"hero-grid\">\n    <div class=\"hero-h1\">\n      <small>品牌 · StartSocks</small>\n      <h1>StartSocks · 节点流量与设备配额的清单总览</h1>\n    </div>\n\n    <div class=\"dash wide\">\n      <div class=\"label\">流量额度区间</div>\n      <div class=\"num\">100GB — 1000GB / 月</div>\n      <div class=\"desc\">按月计费的流量配额，覆盖从单人使用到多人协作的不同用量档位。</div>\n    </div>\n\n    <div class=\"dash a\">\n      <div class=\"label\">设备上限区间</div>\n      <div class=\"num\">3 — 20 台</div>\n      <div class=\"desc\">同一账号下允许同时在线的设备数量，按套餐档位递增。</div>\n    </div>\n\n    <div class=\"dash b\">\n      <div class=\"label\">起步价</div>\n      <div class=\"num\">¥15 / 月</div>\n      <div class=\"desc\">基础版按月支付的费用起点，年付可一次性结算整年费用。</div>\n      <div class=\"row\"><span>年付</span><span>¥150 / 年</span></div>\n    </div>\n\n    <div class=\"dash c\">\n      <div class=\"label\">套餐档位</div>\n      <div class=\"num\">3 档</div>\n      <div class=\"desc\">分为基础版、旗舰版、团队版三档，分别适配不同用量场景。</div>\n    </div>\n\n    <div class=\"dash wide\">\n      <div class=\"label\">结算方式</div>\n      <div class=\"row\"><span>按月付</span><span>每月续费，保留随时调整档位的灵活性</span></div>\n      <div class=\"row\"><span>按年付</span><span>一次结算 12 个月，单价按整年口径列出</span></div>\n      <div class=\"row\"><span>升级与降档</span><span>在剩余周期内可申请切换到其他档位</span></div>\n    </div>\n  </div>\n</header>\n\n<main>\n  <section id=\"plans\">\n    <span class=\"eyebrow\">套餐档位</span>\n    <h2>三档套餐，逐行展开</h2>\n    <p>每个套餐都列出月度费用、年度费用、流量额度、设备上限和包含的节点特性，便于横向比对后再选定适合的一档。</p>\n\n    <div class=\"planlist\">\n\n      <article class=\"plan-row\">\n        <div class=\"top\">\n          <div>\n            <span class=\"name\">基础版</span>\n          </div>\n          <div>\n            <div class=\"price\">¥15 / 月</div>\n            <div class=\"plan-note\">按年付仅需 ¥150 / 年</div>\n          </div>\n        </div>\n        <ul>\n          <li>每月 100GB 流量额度</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>接入普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-row feat\">\n        <div class=\"top\">\n          <div>\n            <span class=\"name\">旗舰版</span>\n            <span class=\"feat-tag\">推荐</span>\n          </div>\n          <div>\n            <div class=\"price\">¥35 / 月</div>\n            <div class=\"plan-note\">按年付仅需 ¥350 / 年</div>\n          </div>\n        </div>\n        <ul>\n          <li>每月 300GB 流量额度</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>覆盖全节点原生流媒体解锁</li>\n          <li>提供 IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-row\">\n        <div class=\"top\">\n          <div>\n            <span class=\"name\">团队版</span>\n          </div>\n          <div>\n            <div class=\"price\">¥85 / 月</div>\n            <div class=\"plan-note\">按年付仅需 ¥850 / 年</div>\n          </div>\n        </div>\n        <ul>\n          <li>每月 1000GB 流量额度</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>提供 VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>配备专属客户经理服务</li>\n        </ul>\n      </article>\n\n    </div>\n  </section>\n\n  <section id=\"use\">\n    <span class=\"eyebrow\">使用说明</span>\n    <h2>从选购到上线的五步流程</h2>\n    <p>以下步骤按时间顺序整理，可作为上线前的检查清单逐项对照。</p>\n\n    <div class=\"receipt\">\n      <h3>上线流程清单</h3>\n      <ol>\n        <li>进入套餐页面，比对三档的流量额度、设备上限与节点特性。</li>\n        <li>选定档位并完成结算，记录下单时间与剩余有效期。</li>\n        <li>在客户端区块中按操作系统选择对应的支持程序，安装并完成登录。</li>\n        <li>首次连接时确认节点列表已正常加载，设备计数同步显示。</li>\n        <li>若出现连接异常，记录错误提示后提交工单，附上截图与时间。</li>\n      </ol>\n      <div class=\"stamps\">\n        <span>STEP 01 · 选购</span>\n        <span>STEP 02 · 结算</span>\n        <span>STEP 03 · 安装</span>\n        <span>STEP 04 · 校验</span>\n        <span>STEP 05 · 反馈</span>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <span class=\"eyebrow\">客户端支持</span>\n    <h2>多系统支持概况</h2>\n    <p>下方按操作系统列出的客户端覆盖范围，仅作为运行环境的参考信息。具体下载地址请以结算后页面内提供的链接为准。</p>\n\n    <div class=\"clients\">\n      <div class=\"client\">\n        <h4>Windows</h4>\n        <p>常规桌面环境均提供对应支持程序，按提示完成安装后重启一次系统。</p>\n        <p class=\"src\">来源：官网下载页</p>\n      </div>\n      <div class=\"client\">\n        <h4>macOS</h4>\n        <p>提供桌面端安装包，首次启动时需在系统设置中放行开发者权限。</p>\n        <p class=\"src\">来源：官网下载页</p>\n      </div>\n      <div class=\"client\">\n        <h4>iOS</h4>\n        <p>在客户端中选择 iOS 配置说明，按描述描述完成描述文件安装。</p>\n        <p class=\"src\">来源：客户端配置说明</p>\n      </div>\n      <div class=\"client\">\n        <h4>Android</h4>\n        <p>提供安卓版本支持程序，安装后允许后台运行以维持连接状态。</p>\n        <p class=\"src\">来源：官网下载页</p>\n      </div>\n      <div class=\"client\">\n        <h4>Linux</h4>\n        <p>提供命令行版本与图形版本两种使用方式，按发行版选择对应包。</p>\n        <p class=\"src\">来源：客户端配置说明</p>\n      </div>\n      <div class=\"client\">\n        <h4>路由器</h4>\n        <p>支持常见路由器固件的插件形式，安装后由路由器统一转发流量。</p>\n        <p class=\"src\">来源：客户端配置说明</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <span class=\"eyebrow\">常见问题</span>\n    <h2>编号清单 · 选购与使用相关</h2>\n    <p>以下问题按编号整理，覆盖计费、设备上限与故障排查几个高频方向。</p>\n\n    <div class=\"faq\">\n\n      <div class=\"faq-q\">\n        <h3>三档套餐之间如何切换？</h3>\n        <p>在有效期内均可申请升级或降档，差价按剩余天数折算后结算。</p>\n      </div>\n\n      <div class=\"faq-q\">\n        <h3>按月付和按年付有什么区别？</h3>\n        <p>按月付每月结算一次，灵活度高；按年付一次结算 12 个月，单价已在套餐页标注。</p>\n      </div>\n\n      <div class=\"faq-q\">\n        <h3>设备数量限制如何计算？</h3>\n        <p>以同一账号下同时在线的设备数量为准，断开后自动释放名额。</p>\n      </div>\n\n      <div class=\"faq-q\">\n        <h3>流量用尽之后会怎样？</h3>\n        <p>当月额度用尽后连接会被暂停，下月重置或升级到更高档位即可恢复。</p>\n      </div>\n\n      <div class=\"faq-q\">\n        <h3>旗舰版比基础版多了哪些功能？</h3>\n        <p>流量升至 300GB，设备升至 5 台，节点覆盖原生流媒体解锁，并附带 IPLC 专线优化与优先工单支持。</p>\n      </div>\n\n      <div class=\"faq-q\">\n        <h3>团队版适用于什么场景？</h3>\n        <p>多设备同时在线、共享高带宽节点，以及需要定制路由的协作场景更贴合这档配置。</p>\n      </div>\n\n      <div class=\"faq-q\">\n        <h3>连接异常时怎么排查？</h3>\n        <p>先确认客户端版本与登录状态，再切换节点测试，若仍未恢复可提交工单附上截图。</p>\n      </div>\n\n      <div class=\"faq-q\">\n        <h3>是否提供发票或对公付款？</h3>\n        <p>团队版及以上档位可在结算页提交企业抬头与开票信息，按月或按年出具票据。</p>\n      </div>\n\n    </div>\n  </section>\n</main>\n\n<footer>\n  <p>StartSocks · 节点流量与套餐清单</p>\n  <p>本页所有价格与额度信息仅作为选购参考，实际结算以下单页面为准。</p>\n  <p class=\"minilinks\">\n    <a href=\"#dashboard\">数据面板</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#use\">使用方法</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </p>\n  <p>© StartSocks</p>\n</footer>",
